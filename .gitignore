.env
.env.*
!.env.example

# Snowflake key-pair credentials (private + public) — never commit
*.p8
snowflake_scale_test_rsa_key*
rsa_key.*
# Key-handling helper scripts — kept local; they name the service account and
# are not part of the shipped app.
/check_snowflake_key.py
/prep_snowflake_key.py

# VS Code MCP config — may contain interpolation refs but we keep it untracked
# so anyone cloning the repo starts from .vscode/mcp.example.json.
.vscode/mcp.json

# Per-user Claude Code state
.claude/settings.local.json

# Python
__pycache__/
tests/__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
build/
dist/

# Vendor docs: only the index is tracked. The PDFs/ZIPs are vendor-owned
# and not redistributable, and the zips total hundreds of MB anyway.
docs/*
!docs/*.md
!docs/.gitkeep
# Layout reference for the UI build (mock HTML + its README) — tracked deliberately.
!docs/reference/
!docs/reference/**
# Re-exclude local working docs that slip past the docs/*.md whitelist above:
# handoff/session notes and accidental "(1)" download duplicates. The real
# tracked docs (the build spec, IDMC_Console_Runbook.md) do not match these.
docs/*Handoff*
docs/*Session*
docs/* (1)*

# Local config for dq_monitor alerts (no IDMC API exposes alert registration;
# this file is consumed only by sibling cron/agent processes).
.dq_monitor_alerts.json

# Mac noise
.DS_Store

# Logs and runtime cache
logs/
.scan_cache/
.mcp.json
*.log

# Scale-pipeline generated state/outputs (regenerable by the orchestrator)
state/
# Generated bulk-import file (1.4 MB, regenerable); keep the source template tracked
templates/CDGC_DQRO_FULL.xlsx
# CDGC column export (7.2 MB data snapshot, regenerable via Export Assets) — not a template
templates/CDGC_CURATE_DATASET.xlsx
# Ad-hoc comparison/marketing docs dropped in templates/ — not pipeline templates.
# (The real templates are CDGC_DQRO_TEMPLATE.xlsx and the "Marketplace - *.xlsx" set.)
templates/*.docx
templates/*.zip
templates/RND.xlsx

# Local secrets (RSA keys etc.)
secrets/

# Pasted reference docs (stale drafts) — keep local, never track
build spec/
