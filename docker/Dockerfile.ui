# Build context is the repo root. Build with: az acr build --file docker/Dockerfile.ui .
FROM python:3.11-slim

WORKDIR /app

COPY . .

RUN pip install --no-cache-dir -e .

# start-ui.sh refuses to run outside a container (it overwrites .env). Azure
# Container Apps runs on containerd, where /.dockerenv doesn't exist — declare
# the container explicitly so the guard passes there too.
ENV RUNNING_IN_CONTAINER=1

EXPOSE 9080

CMD ["bash", "scripts/start-ui.sh"]
